{"parentUuid":"f5409879-cc19-47b9-81e4-7e48929252fb","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_011CcobgVyDFqFyJC8fcgjnZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JCSt5eL3QFyXEoghrynk3y","name":"Write","input":{"file_path":"/tmp/claude-1000/-home-arrenchulz/61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f/scratchpad/midmay_concentration.py","content":"import csv, json, statistics\nfrom pathlib import Path\nimport importlib.util\nspec=importlib.util.spec_from_file_location(\"m\",\"/tmp/claude-1000/-home-arrenchulz/61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f/scratchpad/midmay_autopsy.py\")\n# reuse loaders\nR=Path(\"/mnt/c/Projects/biotech_screener/biotech-screener\")\nSNAP=R/\"data\"/\"snapshots\"; PIT=R/\"data\"/\"caches\"/\"price_pit\"/\"PIT\"\ndef load_rankings(d):\n    p=SNAP/d/\"rankings.csv\"; out={}\n    for row in csv.DictReader(open(p,newline='',encoding='utf-8')):\n        t=(row.get(\"ticker\") or \"\").strip().upper()\n        rk=(row.get(\"actionable_rank\") or row.get(\"composite_rank\") or \"\").strip()\n        if not t or not rk: continue\n        try: out[t]={\"rank\":float(rk),\"mom\":row.get(\"mom_state\",\"\"),\"tier\":row.get(\"tier_any\",\"\"),\n                     \"flags\":row.get(\"risk_flags\",\"\"),\"cat\":row.get(\"catalyst_reason_detail\",\"\")[:60],\n                     \"bucket\":row.get(\"catalyst_bucket\",\"\"),\"ta\":row.get(\"therapeutic_area\",\"\")}\n        except: pass\n    return out\ndef load_fwd(d,h=20):\n    cdir=PIT/d; idx=json.load(open(cdir/\"index.json\"))\n    split={w[\"ticker\"] for w in idx.get(\"split_warnings\",[]) if w.get(\"horizon\")==h}\n    col=f\"h{h}_close\"; out={}\n    for row in csv.DictReader(open(cdir/\"prices.csv\",newline='')):\n        t=(row.get(\"ticker\") or \"\").strip().upper()\n        if t in split: continue\n        a=(row.get(\"anchor_close\") or \"\").strip(); f=(row.get(col) or \"\").strip()\n        if not a or not f: continue\n        try: a=float(a); f=float(f)\n        except: continue\n        if a>0: out[t]=f/a-1.0\n    return out\ndef rankvec(xs):\n    order=sorted(range(len(xs)),key=lambda i:xs[i]); r=[0.0]*len(xs); i=0\n    while i<len(xs):\n        j=i\n        while j+1<len(xs) and xs[order[j+1]]==xs[order[i]]: j+=1\n        for k in range(i,j+1): r[order[k]]=(i+j)/2.0+1\n        i=j+1\n    return r\ndef spearman(a,b):\n    ra,rb=rankvec(a),rankvec(b); n=len(a); ma=sum(ra)/n; mb=sum(rb)/n\n    num=sum((x-ma)*(y-mb) for x,y in zip(ra,rb))\n    da=sum((x-ma)**2 for x in ra)**.5; db=sum((y-mb)**2 for y in rb)**.5\n    return num/(da*db) if da and db else None\n\nd=\"2026-05-14\"\nsig=load_rankings(d); fwd=load_fwd(d)\ncommon=[t for t in sig if t in fwd]\ndef ic_of(names):\n    s=[-sig[t][\"rank\"] for t in names]; r=[fwd[t] for t in names]\n    return spearman(s,r)\nbase=ic_of(common)\nprint(f\"=== {d}: baseline IC (N={len(common)}) = {base:+.4f} ===\\n\")\n\n# recurring loved-losers across mid-May\ncluster=[\"AARD\",\"JBIO\",\"PRAX\",\"CELC\"]\npresent=[t for t in cluster if t in common]\nrest=[t for t in common if t not in present]\nprint(f\"Cluster {present}: removing them -> IC = {ic_of(rest):+.4f}  (from {base:+.4f})\\n\")\n\nprint(\"Cluster context (rank / fwd20d / mom / tier / bucket / flags):\")\nfor t in present:\n    print(f\"  {t:5} rank {int(sig[t]['rank']):>3}  fwd {fwd[t]*100:>+6.1f}%  {sig[t]['mom']:8} {sig[t]['tier']:2} {sig[t]['bucket']:12} flags={sig[t]['flags'][:40]}\")\n\n# momentum-state decomposition: mean fwd by mom_state for top-60\nprint(\"\\nMean fwd 20d by mom_state (whole universe, 05-14):\")\nby={}\nfor t in common:\n    by.setdefault(sig[t][\"mom\"] or \"?\",[]).append(fwd[t])\nfor k,v in sorted(by.items()):\n    print(f\"  {k:10} n={len(v):>3}  mean fwd {statistics.mean(v)*100:>+6.1f}%\")\n\n# how many names to remove to flip IC>=0?\norder=sorted(common,key=lambda t:(-sig[t][\"rank\"]))  # not needed\n# greedily remove biggest negative contributors (liked & fell / d