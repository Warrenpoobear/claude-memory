.optional-dependencies]\ndev = [\n    \"pytest>=8.3,<9\",\n    \"pytest-cov>=7.0,<8\",\n    \"pytest-timeout>=2.2,<3\",\n]\ndata = [\n    \"pandas>=2.1,<3\",\n    \"numpy>=1.26,<2\",\n    \"requests>=2.31,<3\",\n]\noptimization = [\n    \"scipy>=1.11.0\",\n    \"numpy>=1.24.0\",\n]\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\npythonpath = [\".\", \"tests\"]\npython_files = \"test_*.py\"\npython_functions = \"test_*\"\naddopts = \"-q -m 'not network'\"\ntimeout = 120\ntimeout_method = \"thread\"\nmarkers = [\n    \"slow: marks tests that run the full pipeline or take >5s (deselect with '-m \\\"not slow\\\"')\",\n    \"network: marks tests that make live HTTP calls to external APIs (deselect with '-m \\\"not network\\\"')\",\n    \"timeout: override the default per-test timeout (seconds)\",\n]\nfilterwarnings = [\n    \"error::DeprecationWarning\",\n    \"error::FutureWarning\",\n    \"ignore::DeprecationWarning:pandas\",\n    \"ignore::FutureWarning:pandas\",\n    \"ignore::DeprecationWarning:numpy\",\n    \"ignore::DeprecationWarning:tarfile\",\n    \"ignore:.*schema version.*not in supported:DeprecationWarning\",\n    \"ignore:.*is deprecated.*:DeprecationWarning\",\n    \"ignore:.*summaries_legacy.*deprecated:DeprecationWarning\",\n]\n\n[tool.coverage.run]\nsource = [\"common\", \"tools\", \"scripts\"]\nparallel = true\nconcurrency = [\"multiprocessing\"]\nomit = [\n    \"tests/*\",\n    \"*_test.py\",\n    \"test_*.py\",\n    \"setup.py\",\n]\n\n[tool.coverage.report]\nexclude_lines = [\n    \"pragma: no cover\",\n    \"if __name__ == .__main__.:\",\n    \"raise NotImplementedError\",\n]\nshow_missing = true\nfail_under = 50\n\n[tool.black]\nline-length = 120\ntarget-version = [\"py310\"]\n\n[tool.isort]\nprofile = \"black\"\nline_length = 120\n\n[tool.mypy]\npython_version = \"3.10\"\nignore_missing_imports = true\nexplicit_package_bases = true\nwarn_unused_configs = true\n# strict_optional = false is a deliberate relaxation while ~115 type\n# errors i