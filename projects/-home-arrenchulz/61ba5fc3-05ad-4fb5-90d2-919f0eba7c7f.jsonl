{"parentUuid":"d0f8b238-d400-42f4-a328-a4230abc2b39","isSidechain":false,"promptId":"b7dec885-ef7a-4132-bfcd-28e201fa3351","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SpJ8yXdRi9Swqmrgv9tQjJ","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"\n3\tforward_eval_gate.py — Rolling-window IC evaluation using PIT-frozen prices.\n4\t\n5\tComputes Spearman IC between ranking signal and PIT-cached forward returns\n6\tover a rolling window of recent snapshots. Designed as a WARN-only gate\n7\tfor run_daily_production.py.\n8\t\n9\tNever FAIL — always returns PASS or WARN.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\timport csv\n15\timport json\n16\timport logging\n17\timport re\n18\timport sys\n19\tfrom pathlib import Path\n20\tfrom typing import Any, Dict, List, Tuple\n21\t\n22\t# ---------------------------------------------------------------------------\n23\t# Repo root\n24\t# ---------------------------------------------------------------------------\n25\tREPO_ROOT = Path(__file__).resolve().parent.parent\n26\tsys.path.insert(0, str(REPO_ROOT))\n27\t\n28\t# Reuse IC computation from eval_forward_returns (import, not duplicate)\n29\tfrom scripts.eval_forward_returns import spearman_ic\n30\t\n31\tlogging.basicConfig(\n32\t    level=logging.INFO,\n33\t    format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\",\n34\t)\n35\tlogger = logging.getLogger(\"forward_eval_gate\")\n36\t\n37\t\n38\t# ---------------------------------------------------------------------------\n39\t# PIT cache discovery\n40\t# ---------------------------------------------------------------------------\n41\t\n42\t\n43\tdef _discover_pit_dates(\n44\t    cache_base: Path,\n45\t    before_date: str,\n46\t    horizon: int,\n47\t    lookback_n: int,\n48\t) -> List[str]:\n49\t    \"\"\"Find up to lookback_n snapshot dates with PIT caches having horizon filled.\n50\t\n51\t    Returns dates sorted descending (most recent first), all < before_date.\n52\t    \"\"\"\n53\t    if not cache_base.exists():\n54\t        return []\n55\t\n56\t    date_re = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n57\t    candidates: List[str] = []\n58\t\n59\t    for entry in sorted(cache_base.iterdir(), reverse=True):\n60\t        if not entry.is_dir() or not date_re.match(entry.name):\n61\t            continue\n62\t        if entry.name >= before_date:\n63\t            continue\n64\t\n65\t        index_path = entry / \"index.json\"\n66\t        if not index_path.exists():\n67\t            continue\n68\t\n69\t        try:\n70\t            with open(index_path, encoding=\"utf-8\") as f:\n71\t                index = json.load(f)\n72\t        except (json.JSONDecodeError, OSError):\n73\t            continue\n74\t\n75\t        if horizon in index.get(\"horizons_filled\", []):\n76\t            candidates.append(entry.name)\n77\t            if len(candidates) >= lookback_n:\n78\t                break\n79\t\n80\t    return candidates\n81\t\n82\t\n83\tdef _load_pit_prices(cache_dir: Path) -> List[Dict[str, str]]:\n84\t    \"\"\"Load prices.csv from a PIT cache dir.\"\"\"\n85\t    prices_path = cache_dir / \"prices.csv\"\n86\t    if not prices_path.exists():\n87\t        return []\n88\t    with open(prices_path, newline=\"\", encoding=\"utf-8\") as f:\n89\t        return list(csv.DictReader(f))\n90\t\n91\t\n92\tdef _load_rankings_signal(snapshot_dir: Path) -> Dict[str, float]:\n93\t    \"\"\"Load rankings.csv and return {ticker: negative_rank} signal.\n94\t\n95\t    Lower actionable_rank = better → higher signal value (negated).\n96\t    \"\"\"\n97\t    rankings_path = snapshot_dir / \"rankings.csv\"\n98\t    if not rankings_path.exists():\n99\t        return {}\n100\t\n101\t    signal: Dict[str, float] = {}\n102\t    with open(rankings_path, newline=\"\", encoding=\"utf-8\") as f:\n103\t        reader = csv.DictReader(f)\n104\t        for row in reader:\n105\t            ticker = (row.get(\"ticker\") or \"\").strip().upper()\n106\t            rank_str = (row.get(\"actionable_rank\") or row.get(\"composite_rank\") or \"\").strip()\n107\t            if not ticker or not rank_str:\n108\t                continue\n109\t            try:\n110\t                signal[ticker] = -float(rank_str)\n111\t            except (ValueError, TypeError):\n112\t                continue\n113\t    return signal\n114\t\n115\t\n116\tdef _get_split_warning_tickers(cache_dir: Path, horizon: int) -> set:\n117\t    \"\"\"Get tickers with split warnings for a given horizon.\"\"\"\n118\t    index_path = cache_dir / \"index.json\"\n119\t    if not index_path.exists():\n120\t        return set()\n121\t    try:\n122\t        with open(index_path, encoding=\"utf-8\") as f:\n123\t            index = json.load(f)\n124\t    except (json.JSONDecodeError, OSError):\n125\t        return set()\n126\t\n127\t    return {w[\"ticker\"] for w in index.get(\"split_warnings\", []) if w.get(\"horizon\") == horizon}\n128\t\n129\t\n130\t# ---------------------------------------------------------------------------\n131\t# Core: evaluate_rolling_ic\n132\t# ---------------------------------------------------------------------------\n133\t\n134\t\n135\tdef evaluate_rolling_ic(\n136\t    snapshot_dir: Path,\n137\t    price_cache_base: Path,\n138\t    current_date: str,\n139\t    *,\n140\t    horizon: int = 20,\n141\t    lookback_n: int = 10,\n142\t    min_dates: int = 3,\n143\t    top_k: int = 20,\n144\t    ic_warn_floor: float = 0.00,\n145\t) -> Tuple[str, str, Dict[str, Any], Dict[str, Any]]:\n146\t    \"\"\"Rolling-window IC from PIT price caches.\n147\t\n148\t    Returns (status, detail, value, threshold).\n149\t    Status is always \"PASS\" or \"WARN\" — never \"FAIL\".\n150\t    \"\"\"\n151\t    thresholds = {\n152\t        \"ic_warn_floor\": ic_warn_floor,\n153\t        \"lookback_n\": lookback_n,\n154\t        \"min_dates\": min_dates,\n155\t        \"horizon\": horizon,\n156\t    }\n157\t\n158\t    # Discover dates with filled PIT caches\n159\t    pit_dates = _discover_pit_dates(price_cache_base, current_date, horizon, lookback_n)\n160\t\n161\t    if not pit_dates:\n162\t        return (\n163\t            \"PASS\",\n164\t            \"cold-start: no PIT price caches with filled horizons\",\n165\t            {\"n_evaluated\": 0, \"pit_dates\": []},\n166\t            thresholds,\n167\t        )\n168\t\n169\t    # Compute IC for each date\n170\t    ics: List[float] = []\n171\t    date_details: List[Dict[str, Any]] = []\n172\t\n173\t    for snap_date in pit_dates:\n174\t        cache_dir = price_cache_base / snap_date\n175\t        snap_dir = snapshot_dir / snap_date\n176\t\n177\t        # Load signal from rankings\n178\t        signal = _load_rankings_signal(snap_dir)\n179\t        if not signal:\n180\t            date_details.append({\"date\": snap_date, \"ic\": None, \"reason\": \"no_rankings\"})\n181\t            continue\n182\t\n183\t        # Load PIT prices\n184\t        pit_rows = _load_pit_prices(cache_dir)\n185\t        if not pit_rows:\n186\t            date_details.append({\"date\": snap_date, \"ic\": None, \"reason\": \"no_pit_prices\"})\n187\t            continue\n188\t\n189\t        # Exclude split-warning tickers\n190\t        split_tickers = _get_split_warning_tickers(cache_dir, horizon)\n191\t\n192\t        # Compute forward returns from PIT prices\n193\t        close_col = f\"h{horizon}_close\"\n194\t        fwd_rets: Dict[str, float] = {}\n195\t        for row in pit_rows:\n196\t            ticker = (row.get(\"ticker\") or \"\").strip().upper()\n197\t            if ticker in split_tickers:\n198\t                continue\n199\t            anchor_str = (row.get(\"anchor_close\") or \"\").strip()\n200\t            fwd_str = (row.get(close_col) or \"\").strip()\n201\t            if not anchor_str or not fwd_str:\n202\t                continue\n203\t            try:\n204\t                anchor = float(anchor_str)\n205\t                fwd = float(fwd_str)\n206\t            except (ValueError, TypeError):\n207\t                continue\n208\t            if anchor <= 0:\n209\t                continue\n210\t            fwd_rets[ticker] = fwd / anchor - 1.0\n211\t\n212\t        # Compute Spearman IC\n213\t        common_tickers = [t for t in signal if t in fwd_rets]\n214\t        if len(common_tickers) < 3:\n215\t            date_details.append(\n216\t                {\n217\t                    \"date\": snap_date,\n218\t                    \"ic\": None,\n219\t                    \"reason\": f\"insufficient_overlap ({len(common_tickers)})\",\n220\t                }\n221\t            )\n222\t            continue\n223\t\n224\t        signal_vals = [signal[t] for t in common_tickers]\n225\t        return_vals = [fwd_rets[t] for t in common_tickers]\n226\t        ic = spearman_ic(signal_vals, return_vals)\n227\t\n228\t        if ic is not None:\n229\t            ics.append(ic)\n230\t\n231\t        date_details.append(\n232\t            {\n233\t                \"date\": snap_date,\n234\t                \"ic\": round(ic, 4) if ic is not None else None,\n235\t                \"n_tickers\": len(common_tickers),\n236\t                \"n_split_excluded\": len(split_tickers),\n237\t            }\n238\t        )\n239\t\n240\t    n_evaluated = len(ics)\n241\t    value: Dict[str, Any] = {\n242\t        \"n_evaluated\": n_evaluated,\n243\t        \"n_pit_dates\": len(pit_dates),\n244\t        \"date_details\": date_details,\n245\t    }\n246\t\n247\t    if n_evaluated == 0:\n248\t        return (\n249\t            \"PASS\",\n250\t            \"cold-start: insufficient PIT price caches\",\n251\t            value,\n252\t            thresholds,\n253\t        )\n254\t\n255\t    mean_ic = sum(ics) / len(ics)\n256\t    median_ic = sorted(ics)[len(ics) // 2]\n257\t    value[\"mean_ic\"] = round(mean_ic, 4)\n258\t    value[\"median_ic\"] = round(median_ic, 4)\n259\t    value[\"ics\"] = [round(x, 4) for x in ics]\n260\t\n261\t    if n_evaluated < min_dates:\n262\t        return (\n263\t            \"WARN\",\n264\t            f\"insufficient dates: {n_evaluated} < {min_dates} \" f\"(mean_ic={mean_ic:.4f})\",\n265\t            value,\n266\t            thresholds,\n267\t        )\n268\t\n269\t    if mean_ic < ic_warn_floor:\n270\t        return (\n271\t            \"WARN\",\n272\t            f\"mean_ic={mean_ic:.4f} < floor={ic_warn_floor:.4f} \" f\"(n={n_evaluated}, horizon={horizon}d)\",\n273\t            value,\n274\t            thresholds,\n275\t        )\n276\t\n277\t    return (\n278\t        \"PASS\",\n279\t        f\"mean_ic={mean_ic:.4f}, median_ic={median_ic:.4f} \" f\"(n={n_evaluated}, horizon={horizon}d)\",\n280\t        value,\n281\t        thresholds,\n282\t    )\n283\t"}]},"uuid":"1c4c7134-706a-442b-a2b2-924cf8e957fb","timestamp":"2026-07-08T14:13:34.844Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/claude-1000/-home-arrenchulz/61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f/scratchpad/fix-wt/tools/forward_eval_gate.py","content":"#!/usr/bin/env python3\n\"\"\"\nforward_eval_gate.py — Rolling-window IC evaluation using PIT-frozen prices.\n\nComputes Spearman IC between ranking signal and PIT-cached forward returns\nover a rolling window of recent snapshots. Designed as a WARN-only gate\nfor run_daily_production.py.\n\nNever FAIL — always returns PASS or WARN.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport json\nimport logging\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Tuple\n\n# ---------------------------------------------------------------------------\n# Repo root\n# ---------------------------------------------------------------------------\nREPO_ROOT = Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(REPO_ROOT))\n\n# Reuse IC computation from eval_forward_returns (import, not duplicate)\nfrom scripts.eval_forward_returns import spearman_ic\n\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s - %(name)s - %(levelname)s - %(message)s\",\n)\nlogger = logging.getLogger(\"forward_eval_gate\")\n\n\n# ---------------------------------------------------------------------------\n# PIT cache discovery\n# ---------------------------------------------------------------------------\n\n\ndef _discover_pit_dates(\n    cache_base: Path,\n    before_date: str,\n    horizon: int,\n    lookback_n: int,\n) -> List[str]:\n    \"\"\"Find up to lookback_n snapshot dates with PIT caches having horizon filled.\n\n    Returns dates sorted descending (most recent first), all < before_date.\n    \"\"\"\n    if not cache_base.exists():\n        return []\n\n    date_re = re.compile(r\"^\\d{4}-\\d{2}-\\d{2}$\")\n    candidates: List[str] = []\n\n    for entry in sorted(cache_base.iterdir(), reverse=True):\n        if not entry.is_dir() or not date_re.match(entry.name):\n            continue\n        if entry.name >= before_date:\n            continue\n\n        index_path = entry / \"index.json\"\n        if not index_path.exists():\n            continue\n\n        try:\n            with open(index_path, encoding=\"utf-8\") as f:\n                index = json.load(f)\n        except (json.JSONDecodeError, OSError):\n            continue\n\n        if horizon in index.get(\"horizons_filled\", []):\n            candidates.append(entry.name)\n            if len(candidates) >= lookback_n:\n                break\n\n    return candidates\n\n\ndef _load_pit_prices(cache_dir: Path) -> List[Dict[str, str]]:\n    \"\"\"Load prices.csv from a PIT cache dir.\"\"\"\n    prices_path = cache_dir / \"prices.csv\"\n    if not prices_path.exists():\n        return []\n    with open(prices_path, newline=\"\", encoding=\"utf-8\") as f:\n        return list(csv.DictReader(f))\n\n\ndef _load_rankings_signal(snapshot_dir: Path) -> Dict[str, float]:\n    \"\"\"Load rankings.csv and return {ticker: negative_rank} signal.\n\n    Lower actionable_rank = better → higher signal value (negated).\n    \"\"\"\n    rankings_path = snapshot_dir / \"rankings.csv\"\n    if not rankings_path.exists():\n        return {}\n\n    signal: Dict[str, float] = {}\n    with open(rankings_path, newline=\"\", encoding=\"utf-8\") as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            ticker = (row.get(\"ticker\") or \"\").strip().upper()\n            rank_str = (row.get(\"actionable_rank\") or row.get(\"composite_rank\") or \"\").strip()\n            if not ticker or not rank_str:\n                continue\n            try:\n                signal[ticker] = -float(rank_str)\n            except (ValueError, TypeError):\n                continue\n    return signal\n\n\ndef _get_split_warning_tickers(cache_dir: Path, horizon: int) -> set:\n    \"\"\"Get tickers with split warnings for a given horizon.\"\"\"\n    index_path = cache_dir / \"index.json\"\n    if not index_path.exists():\n        return set()\n    try:\n        with open(index_path, encoding=\"utf-8\") as f:\n            index = json.load(f)\n    except (json.JSONDecodeError, OSError):\n        return set()\n\n    return {w[\"ticker\"] for w in index.get(\"split_warnings\", []) if w.get(\"horizon\") == horizon}\n\n\n# ---------------------------------------------------------------------------\n# Core: evaluate_rolling_ic\n# ---------------------------------------------------------------------------\n\n\ndef evaluate_rolling_ic(\n    snapshot_dir: Path,\n    price_cache_base: Path,\n    current_date: str,\n    *,\n    horizon: int = 20,\n    lookback_n: int = 10,\n    min_dates: int = 3,\n    top_k: int = 20,\n    ic_warn_floor: float = 0.00,\n) -> Tuple[str, str, Dict[str, Any], Dict[str, Any]]:\n    \"\"\"Rolling-window IC from PIT price caches.\n\n    Returns (status, detail, value, threshold).\n    Status is always \"PASS\" or \"WARN\" — never \"FAIL\".\n    \"\"\"\n    thresholds = {\n        \"ic_warn_floor\": ic_warn_floor,\n        \"lookback_n\": lookback_n,\n        \"min_dates\": min_dates,\n        \"horizon\": horizon,\n    }\n\n    # Discover dates with filled PIT caches\n    pit_dates = _discover_pit_dates(price_cache_base, current_date, horizon, lookback_n)\n\n    if not pit_dates:\n        return (\n            \"PASS\",\n            \"cold-start: no PIT price caches with filled horizons\",\n            {\"n_evaluated\": 0, \"pit_dates\": []},\n            thresholds,\n        )\n\n    # Compute IC for each date\n    ics: List[float] = []\n    date_details: List[Dict[str, Any]] = []\n\n    for snap_date in pit_dates:\n        cache_dir = price_cache_base / snap_date\n        snap_dir = snapshot_dir / snap_date\n\n        # Load signal from rankings\n        signal = _load_rankings_signal(snap_dir)\n        if not signal:\n            date_details.append({\"date\": snap_date, \"ic\": None, \"reason\": \"no_rankings\"})\n            continue\n\n        # Load PIT prices\n        pit_rows = _load_pit_prices(cache_dir)\n        if not pit_rows:\n            date_details.append({\"date\": snap_date, \"ic\": None, \"reason\": \"no_pit_prices\"})\n            continue\n\n        # Exclude split-warning tickers\n        split_tickers = _get_split_warning_tickers(cache_dir, horizon)\n\n        # Compute forward returns from PIT prices\n        close_col = f\"h{horizon}_close\"\n        fwd_rets: Dict[str, float] = {}\n        for row in pit_rows:\n            ticker = (row.get(\"ticker\") or \"\").strip().upper()\n            if ticker in split_tickers:\n                continue\n            anchor_str = (row.get(\"anchor_close\") or \"\").strip()\n            fwd_str = (row.get(close_col) or \"\").strip()\n            if not anchor_str or not fwd_str:\n                continue\n            try:\n                anchor = float(anchor_str)\n                fwd = float(fwd_str)\n            except (ValueError, TypeError):\n                continue\n            if anchor <= 0:\n                continue\n            fwd_rets[ticker] = fwd / anchor - 1.0\n\n        # Compute Spearman IC\n        common_tickers = [t for t in signal if t in fwd_rets]\n        if len(common_tickers) < 3:\n            date_details.append(\n                {\n                    \"date\": snap_date,\n                    \"ic\": None,\n                    \"reason\": f\"insufficient_overlap ({len(common_tickers)})\",\n                }\n            )\n            continue\n\n        signal_vals = [signal[t] for t in common_tickers]\n        return_vals = [fwd_rets[t] for t in common_tickers]\n        ic = spearman_ic(signal_vals, return_vals)\n\n        if ic is not None:\n            ics.append(ic)\n\n        date_details.append(\n            {\n                \"date\": snap_date,\n                \"ic\": round(ic, 4) if ic is not None else None,\n                \"n_tickers\": len(common_tickers),\n                \"n_split_excluded\": len(split_tickers),\n            }\n        )\n\n    n_evaluated = len(ics)\n    value: Dict[str, Any] = {\n        \"n_evaluated\": n_evaluated,\n        \"n_pit_dates\": len(pit_dates),\n        \"date_details\": date_details,\n    }\n\n    if n_evaluated == 0:\n        return (\n            \"PASS\",\n            \"cold-start: insufficient PIT price caches\",\n            value,\n            thresholds,\n        )\n\n    mean_ic = sum(ics) / len(ics)\n    median_ic = sorted(ics)[len(ics) // 2]\n    value[\"mean_ic\"] = round(mean_ic, 4)\n    value[\"median_ic\"] = round(median_ic, 4)\n    value[\"ics\"] = [round(x, 4) for x in ics]\n\n    if n_evaluated < min_dates:\n        return (\n            \"WARN\",\n            f\"insufficient dates: {n_evaluated} < {min_dates} \" f\"(mean_ic={mean_ic:.4f})\",\n            value,\n            thresholds,\n        )\n\n    if mean_ic < ic_warn_floor:\n        return (\n            \"WARN\",\n            f\"mean_ic={mean_ic:.4f} < floor={ic_warn_floor:.4f} \" f\"(n={n_evaluated}, horizon={horizon}d)\",\n            value,\n            thresholds,\n        )\n\n    return (\n        \"PASS\",\n        f\"mean_ic={mean_ic:.4f}, median_ic={median_ic:.4f} \" f\"(n={n_evaluated}, horizon={horizon}d)\",\n        value,\n        thresholds,\n    )\n","numLines":283,"startLine":1,"totalLines":283}},"sourceToolAssistantUUID":"d0f8b238-d400-42f4-a328-a4230abc2b39","session_id":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","userType":"external","entrypoint":"cli","cwd":"/home/arrenchulz","sessionId":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","version":"2.1.203","gitBranch":"HEAD"}
