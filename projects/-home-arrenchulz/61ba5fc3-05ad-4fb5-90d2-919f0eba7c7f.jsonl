{"parentUuid":"e2073b17-d85c-45a0-b9cd-d454d5001e44","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_011CcobawXSCsiRfJyBhrbyR","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012HP1DddoffCnAKLRMe82w8","name":"Write","input":{"file_path":"/tmp/claude-1000/-home-arrenchulz/61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f/scratchpad/midmay_autopsy.py","content":"import csv, json, os, statistics\nfrom pathlib import Path\n\nR = Path(\"/mnt/c/Projects/biotech_screener/biotech-screener\")\nSNAP = R/\"data\"/\"snapshots\"\nPIT = R/\"data\"/\"caches\"/\"price_pit\"/\"PIT\"\nDATES = [\"2026-05-13\",\"2026-05-14\",\"2026-05-15\",\"2026-05-18\",\"2026-05-19\",\"2026-05-20\",\n         \"2026-05-21\",\"2026-05-27\",\"2026-05-29\",\"2026-06-03\"]  # last 4 = positive recovery\n\ndef load_rankings(d):\n    p = SNAP/d/\"rankings.csv\"\n    out={}\n    if not p.exists(): return out\n    for row in csv.DictReader(open(p, newline='', encoding='utf-8')):\n        t=(row.get(\"ticker\") or \"\").strip().upper()\n        rk=(row.get(\"actionable_rank\") or row.get(\"composite_rank\") or \"\").strip()\n        if not t or not rk: continue\n        try: sig=-float(rk)\n        except: continue\n        out[t]={\"signal\":sig,\"rank\":float(rk),\n                \"mom\":row.get(\"mom_state\",\"\") ,\"tier\":row.get(\"tier_any\",\"\"),\n                \"arch\":row.get(\"archetype\",\"\"),\"ta\":row.get(\"therapeutic_area\",\"\"),\n                \"bucket\":row.get(\"catalyst_bucket\",\"\")}\n    return out\n\ndef load_fwd(d, horizon=20):\n    cdir=PIT/d\n    idx=json.load(open(cdir/\"index.json\"))\n    split={w[\"ticker\"] for w in idx.get(\"split_warnings\",[]) if w.get(\"horizon\")==horizon}\n    col=f\"h{horizon}_close\"\n    out={}\n    for row in csv.DictReader(open(cdir/\"prices.csv\", newline='')):\n        t=(row.get(\"ticker\") or \"\").strip().upper()\n        if t in split: continue\n        a=(row.get(\"anchor_close\") or \"\").strip(); f=(row.get(col) or \"\").strip()\n        if not a or not f: continue\n        try: a=float(a); f=float(f)\n        except: continue\n        if a<=0: continue\n        out[t]=f/a-1.0\n    return out, len(split)\n\ndef rankvec(xs):\n    order=sorted(range(len(xs)), key=lambda i:xs[i])\n    r=[0.0]*len(xs); i=0\n    while i<len(xs):\n        j=i\n        while j+1<len(xs) and xs[order[j+1]]==xs[order[i]]: j+=1\n        avg=(i+j)/2.0+1\n        for k in range(i,j+1): r[order[k]]=avg\n        i=j+1\n    return r\n\ndef spearman(a,b):\n    ra,rb=rankvec(a),rankvec(b); n=len(a)\n    ma=sum(ra)/n; mb=sum(rb)/n\n    num=sum((x-ma)*(y-mb) for x,y in zip(ra,rb))\n    da=(sum((x-ma)**2 for x in ra))**.5; db=(sum((y-mb)**2 for y in rb))**.5\n    return num/(da*db) if da and db else None\n\nprint(f\"{'date':11} {'IC':>7} {'N':>4} | {'top30 fwd':>9} {'univ fwd':>9} {'bot30 fwd':>9} | worst-loved / best-hated\")\nrows_by_date={}\nfor d in DATES:\n    sig=load_rankings(d); fwd,nsplit=load_fwd(d)\n    common=[t for t in sig if t in fwd]\n    if len(common)<3:\n        print(d,\"insufficient\"); continue\n    sv=[sig[t][\"signal\"] for t in common]; rv=[fwd[t] for t in common]\n    ic=spearman(sv,rv)\n    # rank by model preference (rank number asc = most-liked)\n    liked=sorted(common, key=lambda t:sig[t][\"rank\"])\n    top30=liked[:30]; bot30=liked[-30:]\n    tfwd=statistics.mean(fwd[t] for t in top30)\n    ufwd=statistics.mean(fwd[t] for t in common)\n    bfwd=statistics.mean(fwd[t] for t in bot30)\n    # most damaging: model liked (low rank) but big negative fwd\n    loved=sorted(top30, key=lambda t:fwd[t])[:3]\n    hated=sorted(bot30, key=lambda t:-fwd[t])[:3]\n    lv=\", \".join(f\"{t}(r{int(sig[t]['rank'])},{fwd[t]*100:+.0f}%)\" for t in loved)\n    hv=\", \".join(f\"{t}(r{int(sig[t]['rank'])},{fwd[t]*100:+.0f}%)\" for t in hated)\n    print(f\"{d:11} {ic:+.4f} {len(common):>4} | {tfwd*100:>+8.1f}% {ufwd*100:>+8.1f}% {bfwd*100:>+8.1f}% | loved↓ {lv} || hated↑ {hv}\")\n    row