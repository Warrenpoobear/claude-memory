{"parentUuid":"49ea69ee-7259-40c1-b772-ab3fedbca2e7","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/tmp/claude-1000/-home-arrenchulz/61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f/scratchpad/fix-wt/common/options_monitor_v11_model.py","snippet":"1\t\"\"\"Options Monitor v1.1 — Trade verdict + probability model (Spec 040 Sprint 3).\n2\t\n3\tSeparates monitoring verdict from trade verdict. Provides:\n4\t  1. Deterministic trade verdict rules (live now)\n5\t  2. Probability model stub (trained after outcome data accumulates)\n6\t  3. State transition tracking (new/ongoing/resolved)\n7\t\n8\tTrade verdicts are advisory-only in v1.1.\n9\t\n10\tUsage:\n11\t    from common.options_monitor_v11_model import compute_trade_verdict, track_state\n12\t\"\"\"\n13\t\n14\tfrom __future__ import annotations\n15\t\n16\timport json\n17\timport logging\n18\tfrom dataclasses import dataclass\n19\tfrom decimal import Decimal\n20\tfrom pathlib import Path\n21\tfrom typing import Any, Dict, Optional\n22\t\n23\tlogger = logging.getLogger(__name__)\n24\t\n25\t_D = Decimal\n26\t_D0 = _D(\"0\")\n27\t\n28\t\n29\t# ---------------------------------------------------------------------------\n30\t# Trade verdict\n31\t# ---------------------------------------------------------------------------\n32\t\n33\t\n34\t@dataclass(frozen=True)\n35\tclass TradeVerdict:\n36\t    \"\"\"Advisory trade verdict for one ticker.\"\"\"\n37\t\n38\t    bias: str  # LONG_GAMMA | SHORT_PREMIUM_AVOID | POST_EVENT_SHORT_VOL | NO_ACTION\n39\t    confidence: float  # 0-1\n40\t    reason: str  # human-readable explanation\n41\t    primary_factor: str  # EP | SR | SK | DV\n42\t\n43\t\n44\tdef compute_trade_verdict(\n45\t    *,\n46\t    s_final: float,\n47\t    f_ep: float,\n48\t    f_sr: float,\n49\t    f_sk: float,\n50\t    f_dv: float,\n51\t    chain_quality: float,\n52\t    event_window_flag: bool = False,\n53\t    hard_catalyst_flag: bool = False,\n54\t    days_to_catalyst: Optional[int] = None,\n55\t    catalyst_class: str = \"other\",\n56\t    post_event: bool = False,\n57\t    # Probability model outputs (None until model is trained)\n58\t    p_move_gt_implied: Optional[float] = None,\n59\t    p_iv_crush: Optional[float] = None,\n60\t    p_false_positive: Optional[float] = None,\n61\t) -> TradeVerdict:\n62\t    \"\"\"Compute advisory trade verdict from v1.1 features.\n63\t\n64\t    Uses probability model when available, falls back to deterministic\n65\t    rules when probabilities are None (pre-training phase).\n66\t    \"\"\"\n67\t    # Identify primary factor\n68\t    factors = {\"EP\": f_ep, \"SR\": f_sr, \"SK\": f_sk, \"DV\": f_dv}\n69\t    primary = max(factors, key=factors.get)\n70\t\n71\t    # --- Probability-based rules (when model is trained) ---\n72\t    if p_move_gt_implied is not None and p_false_positive is not None:\n73\t        if p_move_gt_implied >= 0.62 and p_false_positive <= 0.35:\n74\t            return TradeVerdict(\n75\t                bias=\"LONG_GAMMA\",\n76\t                confidence=min(p_move_gt_implied, 1 - p_false_positive),\n77\t                reason=f\"p_move={p_move_gt_implied:.2f}, p_fp={p_false_positive:.2f}, primary={primary}\",\n78\t                primary_factor=primary,\n79\t            )\n80\t\n81\t    if post_event and p_iv_crush is not None and p_iv_crush >= 0.65:\n82\t        return TradeVerdict(\n83\t            bias=\"POST_EVENT_SHORT_VOL\",\n84\t            confidence=p_iv_crush,\n85\t            reason=f\"Post-event, p_iv_crush={p_iv_crush:.2f}\",\n86\t            primary_factor=primary,\n87\t        )\n88\t\n89\t    # --- Deterministic fallback rules (pre-training phase) ---\n90\t\n91\t    # LONG_GAMMA: strong event premium + near catalyst + decent quality\n92\t    if event_window_flag and hard_catalyst_flag and f_ep >= 0.65 and chain_quality >= 0.5 and s_final >= 0.60:\n93\t        return TradeVerdict(\n94\t            bias=\"LONG_GAMMA\",\n95\t            confidence=min(s_final, chain_quality),\n96\t            reason=f\"Event window + hard catalyst + EP={f_ep:.2f}, Q={chain_quality:.2f}\",\n97\t            primary_factor=\"EP\",\n98\t        )\n99\t\n100\t    # POST_EVENT_SHORT_VOL: event passed, surface still elevated\n101\t    if post_event and f_ep >= 0.50 and f_sr < 0.30:\n102\t        return TradeVerdict(\n103\t            bias=\"POST_EVENT_SHORT_VOL\",\n104\t            confidence=0.5 * chain_quality,\n105\t            reason=f\"Post-event, EP still elevated={f_ep:.2f}, SR fading={f_sr:.2f}\",\n106\t            primary_factor=\"EP\",\n107\t        )\n108\t\n109\t    # SHORT_PREMIUM_AVOID: high event premium but low quality or high divergence\n110\t    if f_ep >= 0.60 and (chain_quality < 0.4 or f_dv >= 0.50):\n111\t        return TradeVerdict(\n112\t            bias=\"SHORT_PREMIUM_AVOID\",\n113\t            confidence=0.4,\n114\t            reason=f\"High EP={f_ep:.2f} but Q={chain_quality:.2f}, DV={f_dv:.2f}\",\n115\t            primary_factor=primary,\n116\t        )\n117\t\n118\t    # SHORT_PREMIUM_AVOID: strong skew stress on financing catalyst\n119\t    if catalyst_class == \"financing\" and f_sk >= 0.60:\n120\t        return TradeVerdict(\n121\t            bias=\"SHORT_PREMIUM_AVOID\",\n122\t            confidence=0.4,\n123\t            reason=f\"Financing catalyst + high skew stress={f_sk:.2f}\",\n124\t            primary_factor=\"SK\",\n125\t        )\n126\t\n127\t    return TradeVerdict(\n128\t        bias=\"NO_ACTION\",\n129\t        confidence=0.0,\n130\t        reason=\"No actionable signal\",\n131\t        primary_factor=primary,\n132\t    )\n133\t\n134\t\n135\t# ---------------------------------------------------------------------------\n136\t# State tracking (new / ongoing / resolved)\n137\t# ---------------------------------------------------------------------------\n138\t\n139\t\n140\tdef track_state(\n141\t    current_tickers: Dict[str, Dict[str, Any]],\n142\t    prior_state_path: Optional[Path] = None,\n143\t) -> Dict[str, Dict[str, Any]]:\n144\t    \"\"\"Track state transitions across daily runs.\n145\t\n146\t    Args:\n147\t        current_tickers: {ticker: {om11_* fields}} for tickers with verdict != NONE\n148\t        prior_state_path: Path to prior day's state JSON\n149\t\n150\t    Returns:\n151\t        {ticker: {state, ...fields}} with state = NEW | ONGOING | RESOLVED\n152\t    \"\"\"\n153\t    prior: Dict[str, Dict] = {}\n154\t    if prior_state_path and prior_state_path.exists():\n155\t        try:\n156\t            with open(prior_state_path, encoding=\"utf-8\") as f:\n157\t                prior_data = json.load(f)\n158\t            for entry in prior_data.get(\"active\", []):\n159\t                if entry.get(\"ticker\"):\n160\t                    prior[entry[\"ticker\"]] = entry\n161\t        except (json.JSONDecodeError, OSError):\n162\t            pass\n163\t\n164\t    result: Dict[str, Dict[str, Any]] = {}\n165\t\n166\t    # Current tickers: NEW or ONGOING\n167\t    for ticker, fields in current_tickers.items():\n168\t        state = \"ONGOING\" if ticker in prior else \"NEW\"\n169\t        result[ticker] = {**fields, \"state\": state}\n170\t\n171\t    # Prior tickers not in current: RESOLVED\n172\t    for ticker, prev_fields in prior.items():\n173\t        if ticker not in current_tickers:\n174\t            result[ticker] = {\n175\t                \"ticker\": ticker,\n176\t                \"state\": \"RESOLVED\",\n177\t                \"prior_verdict\": prev_fields.get(\"om11_monitor_verdict\", \"\"),\n178\t                \"prior_score\": prev_fields.get(\"om11_score_final\", \"\"),\n179\t            }\n180\t\n181\t    return result\n182\t\n183\t\n184\t# ---------------------------------------------------------------------------\n185\t# Probability model (stub — trained after outcome data)\n186\t# ---------------------------------------------------------------------------\n187\t\n188\t\n189\tclass OM11ProbabilityModel:\n190\t    \"\"\"Calibrated probability model for v1.1 outcomes.\n191\t\n192\t    Stub implementation that returns None for all probabilities until\n193\t    trained on labeled data. Training uses logistic regression with\n194\t    elastic net + isotonic calibration.\n195\t    \"\"\"\n196\t\n197\t    def __init__(self):\n198\t        self._trained = False\n199\t        self._model_move = None\n200\t        self._model_crush = None\n201\t        self._model_fp = None\n202\t\n203\t    @property\n204\t    def is_trained(self) -> bool:\n205\t        return self._trained\n206\t\n207\t    def predict(\n208\t        self,\n209\t        features: Dict[str, Any],\n210\t    ) -> Dict[str, Optional[float]]:\n211\t        \"\"\"Predict probabilities for one observation.\n212\t\n213\t        Returns None for all probabilities if model is not trained.\n214\t        \"\"\"\n215\t        if not self._trained:\n216\t            return {\n217\t                \"p_move_gt_implied\": None,\n218\t                \"p_post_event_iv_crush\": None,\n\n... [141 lines truncated] ..."},"type":"attachment","uuid":"95586b37-db27-4081-bf2a-8c764adfa4ba","timestamp":"2026-07-08T20:34:39.368Z","session_id":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","userType":"external","entrypoint":"cli","cwd":"/home/arrenchulz","sessionId":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","version":"2.1.203","gitBranch":"HEAD"}
