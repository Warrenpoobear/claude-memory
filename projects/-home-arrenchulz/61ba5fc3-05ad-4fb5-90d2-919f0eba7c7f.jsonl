wd[t])\nfor k,v in sorted(by.items()):\n    print(f\"  {k:10} n={len(v):>3}  mean fwd {statistics.mean(v)*100:>+6.1f}%\")\n\n# how many names to remove to flip IC>=0?\norder=sorted(common,key=lambda t:(-sig[t][\"rank\"]))  # not needed\n# greedily remove biggest negative contributors (liked & fell / disliked & rose)\nimport statistics as st\nmed_rank=st.median([sig[t][\"rank\"] for t in common])\ncontrib=[]\nfor t in common:\n    liked = sig[t][\"rank\"]<=60\n    contrib.append((t, fwd[t], liked))\nloved_losers=sorted([c for c in contrib if c[2]], key=lambda x:x[1])[:10]\nprint(\"\\nTop-60 'loved' names ranked by worst fwd (mid-May 05-14):\")\nfor t,f,_ in loved_losers:\n    print(f\"  {t:5} rank {int(sig[t]['rank']):>3}  fwd {f*100:>+6.1f}%\")\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"d9561803-8e45-4455-a484-bac04b0c21fc","session_id":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","userType":"external","entrypoint":"cli","cwd":"/home/arrenchulz","sessionId":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","version":"2.1.203","gitBranch":"HEAD"}
