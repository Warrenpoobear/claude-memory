        _write_rankings_csv(snapshot_dir / d / \"rankings.csv\", tickers_ranks)\n166\t            rows = [{**r, \"anchor_date\": d} for r in pit_rows]\n167\t            _write_pit_cache(cache_base / d, d, rows, horizons_filled=[5])\n168\t\n169\t        status, detail, value, threshold = evaluate_rolling_ic(\n170\t            snapshot_dir=snapshot_dir,\n171\t            price_cache_base=cache_base,\n172\t            current_date=\"2026-02-09\",\n173\t            horizon=5,\n174\t            lookback_n=5,\n175\t            min_dates=3,\n176\t            ic_warn_floor=0.00,\n177\t        )\n178\t        assert status == \"WARN\"\n179\t        assert value[\"mean_ic\"] < 0\n180\t\n181\t    def test_cold_start_returns_pass(self, tmp_path):\n182\t        \"\"\"No PIT caches at all → PASS with cold-start.\"\"\"\n183\t        snapshot_dir = tmp_path / \"snapshots\"\n184\t        cache_base = tmp_path / \"caches\"\n185\t        cache_base.mkdir(parents=True)\n186\t\n187\t        status, detail, value, threshold = evaluate_rolling_ic(\n188\t            snapshot_dir=snapshot_dir,\n189\t            price_cache_base=cache_base,\n190\t            current_date=\"2026-02-09\",\n191\t            horizon=5,\n192\t        )\n193\t        assert status == \"PASS\"\n194\t        assert \"cold-start\" in detail\n195\t\n196\t    def test_insufficient_dates_returns_warn(self, tmp_path):\n197\t        \"\"\"Fewer than min_dates evaluated → WARN.\"\"\"\n198\t        snapshot_dir = tmp_path / \"snapshots\"\n199\t        cache_base = tmp_path / \"caches\"\n200\t\n201\t        tickers_ranks, pit_rows = _make_positive_ic_data()\n202\t\n203\t        # Only 1 date, but min_dates=3\n204\t        d = \"2026-02-02\"\n205\t        _write_rankings_csv(snapshot_dir / d / \"rankings.csv\", tickers_ranks)\n206\t        rows = [{**r, \"anchor_date\": d} for r in pit_rows]\n207\t        _write_pit_cache(cache_base / d, d, rows, horizons_filled=[5])\n208\t\n209\t        status, detail, value, threshold = evaluate_rolling_ic(\n210\t            snapshot_dir=snapshot_dir,\n211\t            price_cache_base=cache_base,\n212\t            current_date=\"2026-02-09\",\n213\t            horizon=5,\n214\t            min_dates=3,\n215\t        )\n216\t        assert status == \"WARN\"\n217\t        assert \"insufficient dates\" in detail\n218\t\n219\t    def test_split_warning_tickers_excluded(self, tmp_path):\n220\t        \"\"\"Tickers with split warnings should be excluded from IC.\"\"\"\n221\t        snapshot_dir = tmp_path / \"snapshots\"\n222\t        cache_base = tmp_path / \"caches\"\n223\t\n224\t        tickers_ranks, pit_rows = _make_positive_ic_data(n_tickers=10)\n225\t\n226\t        d = \"2026-02-02\"\n227\t        _write_rankings_csv(snapshot_dir / d / \"rankings.csv\", tickers_ranks)\n228\t        # Mark first ticker as split warning\n229\t        _write_pit_cache(\n230\t            cache_base / d,\n231\t            d,\n232\t            pit_rows,\n233\t            horizons_filled=[5],\n234\t            split_warnings=[{\"ticker\": \"T000\", \"horizon\": 5}],\n235\t        )\n236\t\n237\t        status, detail, value, threshold = evaluate_rolling_ic(\n238\t            snapshot_dir=snapshot_dir,\n239\t            price_cache_base=cache_base,\n240\t            current_date=\"2026-02-09\",\n241\t            horizon=5,\n242\t            min_dates=1,\n243\t        )\n244\t        # T000 should be excluded\n245\t        for dd in value.get(\"date_details\", []):\n246\t            if dd.get(\"n_split_excluded\") is not None:\n247\t                assert dd[\"n_split_excluded\"] >= 1"}]},"uuid":"ac202f51-4bee-466a-9a9d-b0897771ab7a","timestamp":"2026-07-08T14:16:00.646Z","toolUseResult":{"type":"text","file":{"filePath":"/tmp/claude-1000/-home-arrenchulz/61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f/scratchpad/fix-wt/tests/test_forward_eval_gate.py","content":"\n    def test_positive_ic_returns_pass(self, tmp_path):\n        \"\"\"When ranking predicts returns, IC > 0 → PASS.\"\"\"\n        snapshot_dir = tmp_path / \"snapshots\"\n        cache_base = tmp_path / \"caches\"\n\n        tickers_ranks, pit_rows = _make_positive_ic_data()\n\n        # Create 5 snapshot dates with positive IC data\n        dates = [\"2026-02-02\", \"2026-02-03\", \"2026-02-04\", \"2026-02-05\", \"2026-02-06\"]\n        for d in dates:\n            _write_rankings_csv(snapshot_dir / d / \"rankings.csv\", tickers_ranks)\n            # Adjust pit_rows anchor_date for each\n            rows = [{**r, \"anchor_date\": d} for r in pit_rows]\n            _write_pit_cache(cache_base / d, d, rows, horizons_filled=[5])\n\n        status, detail, value, threshold = evaluate_rolling_ic(\n            snapshot_dir=snapshot_dir,\n            price_cache_base=cache_base,\n            current_date=\"2026-02-09\",\n            horizon=5,\n            lookback_n=5,\n            min_dates=3,\n        )\n        assert status == \"PASS\"\n        assert value[\"mean_ic\"] > 0\n        assert value[\"n_evaluated\"] >= 3\n\n    def test_negative_ic_returns_warn(self, tmp_path):\n        \"\"\"When ranking inversely predicts returns, IC < 0 → WARN.\"\"\"\n        snapshot_dir = tmp_path / \"snapshots\"\n        cache_base = tmp_path / \"caches\"\n\n        tickers_ranks, pit_rows = _make_negative_ic_data()\n\n        dates = [\"2026-02-02\", \"2026-02-03\", \"2026-02-04\", \"2026-02-05\", \"2026-02-06\"]\n        for d in dates:\n            _write_rankings_csv(snapshot_dir / d / \"rankings.csv\", tickers_ranks)\n            rows = [{**r, \"anchor_date\": d} for r in pit_rows]\n            _write_pit_cache(cache_base / d, d, rows, horizons_filled=[5])\n\n        status, detail, value, threshold = evaluate_rolling_ic(\n            snapshot_dir=snapshot_dir,\n            price_cache_base=cache_base,\n            current_date=\"2026-02-09\",\n            horizon=5,\n            lookback_n=5,\n            min_dates=3,\n            ic_warn_floor=0.00,\n        )\n        assert status == \"WARN\"\n        assert value[\"mean_ic\"] < 0\n\n    def test_cold_start_returns_pass(self, tmp_path):\n        \"\"\"No PIT caches at all → PASS with cold-start.\"\"\"\n        snapshot_dir = tmp_path / \"snapshots\"\n        cache_base = tmp_path / \"caches\"\n        cache_base.mkdir(parents=True)\n\n        status, detail, value, threshold = evaluate_rolling_ic(\n            snapshot_dir=snapshot_dir,\n            price_cache_base=cache_base,\n            current_date=\"2026-02-09\",\n            horizon=5,\n        )\n        assert status == \"PASS\"\n        assert \"cold-start\" in detail\n\n    def test_insufficient_dates_returns_warn(self, tmp_path):\n        \"\"\"Fewer than min_dates evaluated → WARN.\"\"\"\n        snapshot_dir = tmp_path / \"snapshots\"\n        cache_base = tmp_path / \"caches\"\n\n        tickers_ranks, pit_rows = _make_positive_ic_data()\n\n        # Only 1 date, but min_dates=3\n        d = \"2026-02-02\"\n        _write_rankings_csv(snapshot_dir / d / \"rankings.csv\", tickers_ranks)\n        rows = [{**r, \"anchor_date\": d} for r in pit_rows]\n        _write_pit_cache(cache_base / d, d, rows, horizons_filled=[5])\n\n        status, detail, value, threshold = evaluate_rolling_ic(\n            snapshot_dir=snapshot_dir,\n            price_cache_base=cache_base,\n            current_date=\"2026-02-09\",\n            horizon=5,\n            min_dates=3,\n        )\n        assert status == \"WARN\"\n        assert \"insufficient dates\" in detail\n\n    def test_split_warning_tickers_excluded(self, tmp_path):\n        \"\"\"Tickers with split warnings should be excluded from IC.\"\"\"\n        snapshot_dir = tmp_path / \"snapshots\"\n        cache_base = tmp_path / \"caches\"\n\n        tickers_ranks, pit_rows = _make_positive_ic_data(n_tickers=10)\n\n        d = \"2026-02-02\"\n        _write_rankings_csv(snapshot_dir / d / \"rankings.csv\", tickers_ranks)\n        # Mark first ticker as split warning\n        _write_pit_cache(\n            cache_base / d,\n            d,\n            pit_rows,\n            horizons_filled=[5],\n            split_warnings=[{\"ticker\": \"T000\", \"horizon\": 5}],\n        )\n\n        status, detail, value, threshold = evaluate_rolling_ic(\n            snapshot_dir=snapshot_dir,\n            price_cache_base=cache_base,\n            current_date=\"2026-02-09\",\n            horizon=5,\n            min_dates=1,\n        )\n        # T000 should be excluded\n        for dd in value.get(\"date_details\", []):\n            if dd.get(\"n_split_excluded\") is not None:\n                assert dd[\"n_split_excluded\"] >= 1","numLines":120,"startLine":128,"totalLines":344}},"sourceToolAssistantUUID":"b13a78f3-6f2d-4f4d-9ee7-d05c37d97e9e","session_id":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","userType":"external","entrypoint":"cli","cwd":"/home/arrenchulz","sessionId":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","version":"2.1.203","gitBranch":"HEAD"}
