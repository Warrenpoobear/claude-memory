t aren't in the baseline.\n          detect-secrets scan \\\n            common/ tools/ scripts/ wake_robin_data_pipeline/ \\\n            mcp_server/ adapters/ config/ \\\n            decision_engine.py run_screen.py \\\n            .env.example docker-compose.yml Dockerfile requirements.txt \\\n            --baseline .secrets.baseline \\\n          && echo \"No new secrets detected.\"\n\n  dep-audit:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n\n      - uses: actions/setup-python@v5\n        with:\n          python-version: \"3.12\"\n          cache: \"pip\"\n\n      - name: Install deps + pip-audit\n        run: |\n          python -m pip install --upgrade pip\n          pip install -r requirements.txt\n          pip install pip-audit\n\n      - name: Audit dependencies for known CVEs\n        run: |\n          pip-audit -r requirements.txt \\\n            --desc \\\n            --fix --dry-run \\\n            --output json \\\n            | tee audit-results.json\n          # Fail on high/critical vulnerabilities\n          pip-audit -r requirements.txt --strict\n\n      - name: Upload audit results\n        if: always()\n        uses: actions/upload-artifact@v4\n        with:\n          name: dep-audit-results\n          path: audit-results.json\n          retention-days: 30\n\n  pytest:\n    runs-on: ubuntu-latest\n    strategy:\n      fail-fast: false\n      matrix:\n        python-version: [\"3.10\", \"3.12\"]\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - uses: actions/setup-python@v5\n        with:\n          python-version: ${{ matrix.python-version }}\n          cache: \"pip\"\n\n      - name: Install deps\n        run: |\n          python -m pip install --upgrade pip\n          pip install -r requirements.txt\n          pip install pytest-xdist yfinance\n          pip install -e .\n\n      - name: Run tests with coverage (single-process)\n        env:\n          PYTHONHA