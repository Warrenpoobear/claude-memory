{"parentUuid":"f25aad58-db15-4001-8579-7918f1105439","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"/tmp/claude-1000/-home-arrenchulz/61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f/scratchpad/fix-wt/tools/cron_daily_production.sh","snippet":"1\t#!/usr/bin/env bash\n2\t# cron_daily_production.sh — Automated daily production screen runner.\n3\t#\n4\t# Designed for cron on WSL2. Runs the full daily production pipeline\n5\t# for today's date, logging output to a dated log file.\n6\t#\n7\t# Usage:\n8\t#   ./tools/cron_daily_production.sh              # run for today\n9\t#   ./tools/cron_daily_production.sh 2026-03-20   # run for specific date\n10\t#   ./tools/cron_daily_production.sh --catch-up   # backfill missed weekdays\n11\t#\n12\t# Cron example (weekdays at 4:30 PM ET, after market close):\n13\t#   30 16 * * 1-5 /mnt/c/Projects/biotech_screener/biotech-screener/tools/cron_daily_production.sh >> /mnt/c/Projects/biotech_screener/biotech-screener/logs/cron.log 2>&1\n14\t# On WSL2 reboot, catch up any missed days:\n15\t#   @reboot sleep 60 && /mnt/c/Projects/biotech_screener/biotech-screener/tools/cron_daily_production.sh --catch-up >> /mnt/c/Projects/biotech_screener/biotech-screener/logs/cron.log 2>&1\n16\t\n17\tset -euo pipefail\n18\t\n19\tREPO_ROOT=\"/mnt/c/Projects/biotech_screener/biotech-screener\"\n20\tPYTHON=\"/usr/bin/python3\"\n21\tLOG_DIR=\"${REPO_ROOT}/logs\"\n22\tLOCK_FILE=\"${REPO_ROOT}/logs/.daily_production.lock\"\n23\tSNAPSHOT_DIR=\"${REPO_ROOT}/data/snapshots\"\n24\tMAX_CATCHUP_DAYS=5\n25\t\n26\t# Class P: cron may invoke this script by absolute path with cwd != repo.\n27\tcd \"${REPO_ROOT}\"\n28\t\n29\t# --- Catch-up mode: find and run missed weekdays ---\n30\tif [ \"${1:-}\" = \"--catch-up\" ]; then\n31\t    echo \"[$(date -Iseconds)] Catch-up: scanning last ${MAX_CATCHUP_DAYS} weekdays for missed runs\"\n32\t    MISSED=0\n33\t    for i in $(seq 1 ${MAX_CATCHUP_DAYS}); do\n34\t        CHECK_DATE=$(date -d \"-${i} days\" +%Y-%m-%d 2>/dev/null || continue)\n35\t        CHECK_DOW=$(date -d \"${CHECK_DATE}\" +%u 2>/dev/null || continue)\n36\t        # Skip weekends\n37\t        [ \"${CHECK_DOW}\" -gt 5 ] && continue\n38\t        # Contract-aware skip. PASS (rc=0) or optional-only-missing (rc=2)\n39\t        # means the snapshot is good enough; FAIL (rc=1) means at least one\n40\t        # required artifact is missing or empty. We only do an expensive\n41\t        # full re-run when rankings.csv itself is missing — diagnostic-only\n42\t        # gaps are left for cron_diagnostics_backstop.sh to repair.\n43\t        if [ -d \"${SNAPSHOT_DIR}/${CHECK_DATE}\" ]; then\n44\t            CONTRACT_RC=0\n45\t            ${PYTHON} tools/check_output_contract.py \\\n46\t                --as-of \"${CHECK_DATE}\" \\\n47\t                --snapshot-root \"${SNAPSHOT_DIR}\" \\\n48\t                >/dev/null 2>&1 || CONTRACT_RC=$?\n49\t            if [ \"${CONTRACT_RC}\" -eq 0 ] || [ \"${CONTRACT_RC}\" -eq 2 ]; then\n50\t                continue\n51\t            fi\n52\t            if [ -f \"${SNAPSHOT_DIR}/${CHECK_DATE}/rankings.csv\" ]; then\n53\t                echo \"[$(date -Iseconds)] Catch-up: ${CHECK_DATE} has rankings.csv but missing required diagnostics — leaving for diagnostics backstop\"\n54\t                continue\n55\t            fi\n56\t            echo \"[$(date -Iseconds)] Catch-up: ${CHECK_DATE} snapshot dir exists but rankings.csv missing — full re-run\"\n57\t        fi\n58\t        echo \"[$(date -Iseconds)] Catch-up: missed ${CHECK_DATE}, running backfill\"\n59\t        \"$0\" \"${CHECK_DATE}\" || true\n60\t        MISSED=$((MISSED + 1))\n61\t    done\n62\t    if [ ${MISSED} -eq 0 ]; then\n63\t        echo \"[$(date -Iseconds)] Catch-up: no missed runs found\"\n64\t    else\n65\t        echo \"[$(date -Iseconds)] Catch-up: backfilled ${MISSED} missed day(s)\"\n66\t    fi\n67\t    exit 0\n68\tfi\n69\t\n70\t# Date: use argument or today\n71\tAS_OF_DATE=\"${1:-$(date +%Y-%m-%d)}\"\n72\t\n73\t# Ensure log directory exists\n74\tmkdir -p \"${LOG_DIR}\"\n75\t\n76\t# Prevent concurrent runs\n77\tif [ -f \"${LOCK_FILE}\" ]; then\n78\t    LOCK_PID=$(cat \"${LOCK_FILE}\" 2>/dev/null || echo \"\")\n79\t    if [ -n \"${LOCK_PID}\" ] && kill -0 \"${LOCK_PID}\" 2>/dev/null; then\n80\t        echo \"[$(date -Iseconds)] SKIP: another daily production run is active (PID ${LOCK_PID})\"\n81\t        exit 0\n82\t    else\n83\t        echo \"[$(date -Iseconds)] WARN: stale lock file removed (PID ${LOCK_PID} not running)\"\n84\t        rm -f \"${LOCK_FILE}\"\n85\t    fi\n86\tfi\n87\t\n88\t# Write lock\n89\techo $$ > \"${LOCK_FILE}\"\n90\ttrap 'rm -f \"${LOCK_FILE}\"' EXIT\n91\t\n92\t# Load environment\n93\tif [ -f \"${REPO_ROOT}/.env\" ]; then\n94\t    # Use python-dotenv style parsing to avoid bash expansion of $ in values.\n95\t    # `source .env` breaks on values like passwords containing $, backticks, etc.\n96\t    while IFS= read -r line || [ -n \"${line}\" ]; do\n97\t        # Skip comments and blank lines\n98\t        [[ -z \"${line}\" || \"${line}\" =~ ^[[:space:]]*# ]] && continue\n99\t        # Strip surrounding quotes from value\n100\t        key=\"${line%%=*}\"\n101\t        val=\"${line#*=}\"\n102\t        val=\"${val#\\\"}\" ; val=\"${val%\\\"}\"\n103\t        val=\"${val#\\'}\" ; val=\"${val%\\'}\"\n104\t        export \"${key}=${val}\"\n105\t    done < \"${REPO_ROOT}/.env\"\n106\tfi\n107\t\n108\tLOG_FILE=\"${LOG_DIR}/daily_production_${AS_OF_DATE}.log\"\n109\t\n110\techo \"[$(date -Iseconds)] Starting daily production for ${AS_OF_DATE}\" | tee -a \"${LOG_FILE}\"\n111\t\n112\t# Check if it's a weekday (skip weekends)\n113\tDOW=$(date -d \"${AS_OF_DATE}\" +%u 2>/dev/null || echo \"0\")\n114\tif [ \"${DOW}\" -gt 5 ]; then\n115\t    echo \"[$(date -Iseconds)] SKIP: ${AS_OF_DATE} is a weekend (day ${DOW})\" | tee -a \"${LOG_FILE}\"\n116\t    exit 0\n117\tfi\n118\t\n119\t# Run the production pipeline (timeout: 75 minutes).\n120\t# Budget breakdown observed: snapshot ~25 min + Herald ≤10 min + AACT ≤30 min\n121\t# (Mondays only) + tail steps ≤5 min = ~70 min worst case. The previous 45-min\n122\t# budget was killing the python child mid-AACT before the wrapper could reach\n123\t# its own PASS/FAIL summary block.\n124\tPIPELINE_TIMEOUT=6000\n125\tif command -v timeout >/dev/null 2>&1; then\n126\t    timeout --signal=TERM --kill-after=60 ${PIPELINE_TIMEOUT} \\\n127\t        ${PYTHON} tools/run_daily_production.py \\\n128\t        --as-of-date \"${AS_OF_DATE}\" \\\n129\t        >> \"${LOG_FILE}\" 2>&1\n130\t    EXIT_CODE=$?\n131\t    if [ ${EXIT_CODE} -eq 124 ]; then\n132\t        echo \"[$(date -Iseconds)] TIMEOUT: pipeline exceeded ${PIPELINE_TIMEOUT}s — killed\" | tee -a \"${LOG_FILE}\"\n133\t    fi\n134\telse\n135\t    ${PYTHON} tools/run_daily_production.py \\\n136\t        --as-of-date \"${AS_OF_DATE}\" \\\n137\t        >> \"${LOG_FILE}\" 2>&1\n138\t    EXIT_CODE=$?\n139\tfi\n140\t\n141\tif [ ${EXIT_CODE} -eq 0 ]; then\n142\t    echo \"[$(date -Iseconds)] PASS: daily production completed successfully\" | tee -a \"${LOG_FILE}\"\n143\telif [ ${EXIT_CODE} -eq 2 ]; then\n144\t    echo \"[$(date -Iseconds)] WARN: daily production completed with warnings (exit 2)\" | tee -a \"${LOG_FILE}\"\n145\telse\n146\t    echo \"[$(date -Iseconds)] FAIL: daily production failed (exit ${EXIT_CODE})\" | tee -a \"${LOG_FILE}\"\n147\tfi\n148\t\n149\t# --- Failure notification ---\n150\t# Send alert on non-zero exit so pipeline failures don't go unnoticed.\n151\t# Configure PIPELINE_ALERT_WEBHOOK in .env (e.g. Slack/Discord incoming webhook URL).\n152\tif [ ${EXIT_CODE} -ne 0 ] && [ -n \"${PIPELINE_ALERT_WEBHOOK:-}\" ]; then\n153\t    _STATUS=\"FAIL\"\n154\t    [ ${EXIT_CODE} -eq 2 ] && _STATUS=\"WARN\"\n155\t    curl -sf -X POST \"${PIPELINE_ALERT_WEBHOOK}\" \\\n156\t        -H \"Content-Type: application/json\" \\\n157\t        -d \"{\\\"text\\\":\\\"[Wake Robin] ${_STATUS}: daily production ${AS_OF_DATE} exited ${EXIT_CODE}. Log: ${LOG_FILE}\\\"}\" \\\n158\t        >> \"${LOG_FILE}\" 2>&1 || true\n159\tfi\n160\t\n161\t# --- Rank-change monitor (read-only diagnostic) ---\n162\t# Compares today's rankings.csv to the most recent prior snapshot and writes\n163\t# rank_change_alerts.{csv,md,json} into the snapshot dir. Read-only — does NOT\n164\t# change scoring, selectors, ranking, eligibility, or portfolio construction.\n165\t# Gated on the snapshot's rankings.csv existing rather than the pipeline's\n166\t# overall exit status: post-snapshot tasks (Herald, AACT, etc.) sometimes\n167\t# hang and never return EXIT_CODE, but the snapshot itself is already\n168\t# complete by then — this gate fires whenever the diagnostic has data.\n169\tif [ -f \"${SNAPSHOT_DIR}/${AS_OF_DATE}/rankings.csv\" ]; then\n170\t    ${PYTHON} tools/build_rank_change_monitor.py \\\n171\t        --as-of-date \"${AS_OF_DATE}\" \\\n172\t        --print-alerts \\\n173\t        2>&1 | tee -a \"${LOG_FILE}\" || \\\n\n... [180 lines truncated] ..."},"type":"attachment","uuid":"b323a72a-a009-4a15-b188-962d0f35f2e2","timestamp":"2026-07-08T14:50:01.778Z","session_id":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","userType":"external","entrypoint":"cli","cwd":"/home/arrenchulz","sessionId":"61ba5fc3-05ad-4fb5-90d2-919f0eba7c7f","version":"2.1.203","gitBranch":"HEAD"}
