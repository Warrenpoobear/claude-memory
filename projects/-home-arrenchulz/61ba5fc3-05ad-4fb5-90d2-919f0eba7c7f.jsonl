of: str, rows: List[Dict], horizons_filled=None, split_warnings=None):\n49\t    \"\"\"Write a complete PIT cache (index.json + prices.csv).\"\"\"\n50\t    cache_dir.mkdir(parents=True, exist_ok=True)\n51\t    horizons_filled = horizons_filled or [5]\n52\t\n53\t    index = {\n54\t        \"schema_version\": \"price_pit_index.v1\",\n55\t        \"cache_type\": \"price_pit\",\n56\t        \"as_of_date\": as_of,\n57\t        \"created_at\": f\"{as_of}T22:00:00Z\",\n58\t        \"source_csv_sha256\": \"a\" * 64,\n59\t        \"ticker_count\": len(rows),\n60\t        \"anchor_date\": as_of,\n61\t        \"horizons_filled\": horizons_filled,\n62\t        \"horizons_pending\": [h for h in [5, 20, 63] if h not in horizons_filled],\n63\t        \"split_warnings\": split_warnings or [],\n64\t        \"coverage_pct\": 100.0,\n65\t        \"tickers_missing_anchor\": [],\n66\t    }\n67\t    with open(cache_dir / \"index.json\", \"w\") as f:\n68\t        json.dump(index, f, indent=2)\n69\t\n70\t    fieldnames = [\"ticker\", \"anchor_date\", \"anchor_close\", \"h5_date\", \"h5_close\"]\n71\t    with open(cache_dir / \"prices.csv\", \"w\", newline=\"\") as f:\n72\t        writer = csv.DictWriter(f, fieldnames=fieldnames)\n73\t        writer.writeheader()\n74\t        writer.writerows(rows)\n75\t\n76\t\n77\tdef _make_positive_ic_data(n_tickers=20):\n78\t    \"\"\"Create data where better-ranked tickers have higher returns (positive IC).\"\"\"\n79\t    tickers = [f\"T{i:03d}\" for i in range(n_tickers)]\n80\t    tickers_ranks = [(t, i + 1) for i, t in enumerate(tickers)]\n81\t\n82\t    # Better rank → higher forward return (monotonic)\n83\t    pit_rows = []\n84\t    for i, t in enumerate(tickers):\n85\t        anchor = 10.0\n86\t        # Higher rank (lower number) → higher return\n87\t        fwd = anchor * (1.0 + 0.10 - i * 0.01)\n88\t        pit_rows.append(\n89\t            {\n90\t                \"ticker\": t,\n91\t                \"anchor_date\": \"2026-02-09\",\n92\t           